{
  "name": "webrtc-p2p-chat",
  "version": "0.2.0",
  "description": "Chat de vídeo/tela/texto P2P descentralizado com Electron + Trystero (sem servidor)",
  "main": "main.js",
  "scripts": {
    "build": "esbuild renderer/index.js --bundle --outfile=dist/renderer.js --format=iife --platform=browser",
    "watch": "esbuild renderer/index.js --bundle --outfile=dist/renderer.js --format=iife --platform=browser --watch",
    "start": "npm run build && electron .",
    "dev": "electron .",
    "pack:win": "npm run build && electron-packager . \"P2P Chat\" --platform=win32 --arch=x64 --out=release --overwrite --app-version=0.2.0 --ignore=\"(node_modules|release|\\.git)\""
  },
  "author": "Kaio",
  "license": "MIT",
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^32.0.0",
    "esbuild": "^0.24.0",
    "trystero": "^0.20.0"
  }
}
